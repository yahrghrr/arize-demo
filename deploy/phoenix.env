# /etc/default/phoenix — settings for the Phoenix server (restart phoenix after editing)

# Where Phoenix keeps its SQLite database. For Postgres, set PHOENIX_SQL_DATABASE_URL instead,
# e.g. postgresql://user:pass@dbhost:5432/phoenix
PHOENIX_WORKING_DIR=/var/lib/phoenix

# UI + OTLP/HTTP collector (http://<vm>:6006/v1/traces) and OTLP/gRPC collector
PHOENIX_HOST=0.0.0.0
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# Uncomment to require login and API keys (also set PHOENIX_API_KEY in /etc/default/phoenix-demo-app)
# PHOENIX_ENABLE_AUTH=True
# PHOENIX_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
