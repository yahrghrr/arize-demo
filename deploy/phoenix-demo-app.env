# /etc/default/phoenix-demo-app — settings for the demo app (restart phoenix-demo-app after editing)

APP_PORT=8000
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=phoenix-demo
# PHOENIX_API_KEY=            # only when PHOENIX_ENABLE_AUTH=True on the server

# auto = real Claude calls when ANTHROPIC_API_KEY is set, mock otherwise. Or force: claude | mock
LLM_MODE=auto
# ANTHROPIC_API_KEY=sk-ant-...
DEMO_CLAUDE_MODEL=claude-opus-5-5
DEMO_CLAUDE_EFFORT=low

# Mock mode only: share of LLM calls that fail with a simulated "overloaded" error
MOCK_FAILURE_RATE=0.02
